# ============================================================
#  MediConnect — Root .gitignore
#  Covers: Python/Django backend, Node/Vite frontend,
#          editors, OS artefacts, and sensitive files.
# ============================================================

# ─── Environment & Secrets (NEVER commit these) ─────────────
**/.env
**/.env.local
**/.env.production
**/.env.staging
!**/.env.example          # Always keep the template

# ─── Python / Django ────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
wheels/
pip-wheel-metadata/
share/python-wheels/
.installed.cfg
lib/
lib64/

# Virtual environments
venv/
.venv/
ENV/
env/

# Django specific
*.sqlite3
*.sqlite3-journal
db.sqlite3
backend/db.sqlite3
/backend/staticfiles/
/backend/media/
/backend/mediafiles/
backend/staticfiles/
backend/media/

# Django local settings overrides
local_settings.py
backend/local_settings.py

# Coverage / testing
.coverage
htmlcov/
.pytest_cache/
nosetests.xml
coverage.xml
*.cover
.hypothesis/

# ─── Node / Frontend ────────────────────────────────────────
node_modules/
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Vite / build output
frontend/dist/
frontend/.vite/
dist/
.vite/

# ─── IDE / Editors ──────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*.sublime-workspace
*.sublime-project
.atom/

# JetBrains / PyCharm
*.iml
.idea/

# ─── OS Artefacts ───────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ─── Logs ───────────────────────────────────────────────────
*.log
logs/
*.pid

# ─── Docker ─────────────────────────────────────────────────
# (Uncomment if you don't want to commit Docker files)
# Dockerfile
# docker-compose.yml
# docker-compose.override.yml

# ─── Misc ───────────────────────────────────────────────────
*.bak
*.tmp
*.orig
.cache/
