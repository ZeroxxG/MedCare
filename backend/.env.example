# ============================================================
#  MediConnect Backend — Environment Variables
#  Copy this file to .env and fill in your real values.
#  NEVER commit the .env file to version control.
# ============================================================

# ─── Django Core ────────────────────────────────────────────
# Generate a strong key with:  python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-strong-random-secret-key-here

# Set to False in production
DEBUG=True

# Comma-separated list of allowed hostnames
# e.g. localhost,127.0.0.1,mediconnect.yourdomain.com
ALLOWED_HOSTS=localhost,127.0.0.1

# ─── Database ───────────────────────────────────────────────
# Default: SQLite (fine for local dev)
# For PostgreSQL, uncomment and fill:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/mediconnect_db

# ─── Email / SMTP ───────────────────────────────────────────
# Leave blank to fall back to console output (emails print to terminal).
# For Gmail: enable 2FA and create an App Password at:
#   https://myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_gmail_app_password
DEFAULT_FROM_EMAIL=MediConnect Healthcare <your_email@gmail.com>

# ─── Razorpay ───────────────────────────────────────────────
# Get keys from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_SECRET

# ─── Google OAuth 2.0 ───────────────────────────────────────
# Get Client ID from: https://console.cloud.google.com/apis/credentials
# Add http://localhost:5173 as an Authorised JavaScript Origin (for local dev)
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com

# ─── Stripe (Optional) ──────────────────────────────────────
# Get keys from: https://dashboard.stripe.com/apikeys
STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_STRIPE_PUBLISHABLE_KEY
STRIPE_SECRET_KEY=sk_test_YOUR_STRIPE_SECRET_KEY
